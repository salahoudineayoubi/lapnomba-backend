NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000

# --- Base de données (MongoDB) ---
# MONGO_URI est prioritaire ; sinon l'URI est construite depuis DB_*.
MONGO_URI=mongodb://localhost:27017/lapnomba
DB_HOST=localhost
DB_PORT=27017
DB_NAME=lapnomba
DB_USER=
DB_PASS=

# --- Auth admin ---
# OBLIGATOIRE : sans lui, la connexion admin est désactivée. 32+ caractères aléatoires,
# ex: openssl rand -base64 48
JWT_SECRET=changeme-utiliser-openssl-rand-base64-48
ADMIN_TOKEN_EXPIRY=12h
ADMIN_EMAIL=admin@lapnomba.org
ADMIN_PASSWORD=changeme

# --- Email transactionnel (tous les emails automatiques du backend) ---
# SMTP_USER/SMTP_PASS = identité D'AUTHENTIFICATION SMTP (peut être une boîte
# différente de l'expéditeur affiché — voir utils/sendMail/index.ts).
SMTP_HOST=changeme
SMTP_PORT=465
SMTP_USER=changeme
SMTP_PASS=changeme

# Expéditeur affiché ("From") de TOUT email automatique — candidature,
# Academy, dons, etc. Doit être une boîte/alias noreply@lapnomba.org créé et
# autorisé côté serveur mail avant la mise en production (voir rapport de
# standardisation des communications — "Deployment Requirements"). À défaut
# de SMTP_FROM_EMAIL, le code retombe sur SMTP_USER plutôt que d'inventer
# une adresse (voir commentaire dans utils/sendMail/index.ts).
SMTP_FROM_NAME=Lap Nomba Foundation
SMTP_FROM_EMAIL=noreply@lapnomba.org

# Canal humain — Reply-To par défaut de tout email automatique, et adresse
# affichée publiquement (footer, pages de contact). Pas un secret.
SUPPORT_EMAIL=support@lapnomba.org

# Numéro WhatsApp support officiel — affichage et liens wa.me dérivés
# centralement depuis cette seule valeur (voir utils/emailSupport.ts).
# Pas un secret.
SUPPORT_WHATSAPP=+237657588317

# Notification interne à chaque nouvelle candidature éligible (pas un secret)
TRAINING_NOTIFICATION_EMAIL=training@lapnomba.org

# --- Uploads (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Chatbot ---
OPENAI_API_KEY=
# Pemi AI (facultatif) : modèle qui raisonne + recherche web, et modèle de secours.
# CHATBOT_MODEL=gpt-5-mini
# CHATBOT_REASONING_EFFORT=low   # minimal | low | medium | high
# CHATBOT_WEB_SEARCH=true
# CHATBOT_FALLBACK_MODEL=gpt-4o-mini

# --- Dons : URLs de retour ---
DONATIONS_RETURN_URL=https://donate.lapnomba.org/payment/success
DONATIONS_CANCEL_URL=https://donate.lapnomba.org/payment/cancel
ACADEMY_PAYMENT_RETURN_URL=https://academy.lapnomba.org/payment/return

# --- Smobilpay (Maviance) — MTN MoMo / Orange Money / carte ---
SMOBILPAY_CONSUMER_KEY=
SMOBILPAY_CONSUMER_SECRET=
SMOBILPAY_TOKEN_URL=
SMOBILPAY_ORDER_URL=
SMOBILPAY_ORDER_STATUS_URL=
SMOBILPAY_ORDER_DETAILS_URL=
SMOBILPAY_CALLBACK_URL=https://<api>/api/smobilpay/webhook
SMOBILPAY_RETURN_URL=
SMOBILPAY_DEFAULT_CURRENCY=XAF
SMOBILPAY_DEFAULT_LANG_KEY=fr
SMOBILPAY_ORDER_VERSION=
SMOBILPAY_TIMEOUT_MS=20000
SMOBILPAY_MTN_MERCHANT_CODE=
SMOBILPAY_MTN_SERVICE_ID=
SMOBILPAY_ORANGE_MERCHANT_CODE=
SMOBILPAY_ORANGE_SERVICE_ID=
SMOBILPAY_CARD_MERCHANT_CODE=
SMOBILPAY_CARD_SERVICE_ID=
